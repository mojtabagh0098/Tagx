# Bot token: create a NEW token with @BotFather and paste it here.
BOT_TOKEN=PASTE_NEW_BOTFATHER_TOKEN_HERE

# The owner's Telegram numeric user ID.
OWNER_ID=7365481512

# Required for Vercel only: PostgreSQL connection string (e.g. a Neon pooled URL).
DATABASE_URL=

# Required for Vercel webhooks. Generate a random 32+ character value.
# Use the same value in Vercel project settings and this local file.
WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Optional. Local default is bot_database.json beside bot.py.
# On Vercel the handler uses /tmp as a disposable cache automatically.
# BOT_DATABASE_PATH=./bot_database.json

# Optional: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
